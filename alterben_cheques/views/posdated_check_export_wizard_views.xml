<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_alterben_posdated_check_export_wizard_form" model="ir.ui.view">
        <field name="name">alterben.posdated.check.export.wizard.form</field>
        <field name="model">alterben.posdated.check.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Excel para Importar Pagos" create="false" edit="true">
                <sheet>
                    <group>
                        <field name="check_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="mark_as_deposited"/>
                    </group>
                    <group string="Parámetros del Pago (Importación account.payment)">
                        <field name="journal_id"/>
                        <field name="payment_method_line_id"/>
                        <field name="payment_date"/>
                    </group>
                    <group invisible="not file_data">
                        <field name="file_name" readonly="1"/>
                        <field name="file_data" filename="file_name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_excel" type="object" class="btn-primary" string="Generar Excel"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_alterben_posdated_check_export_wizard" model="ir.actions.act_window">
        <field name="name">Generar Excel para Importar Pagos</field>
        <field name="res_model">alterben.posdated.check.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{"default_check_ids": active_ids}</field>
    </record>
</odoo>
