<odoo>
    <record id="view_mrp_production_form_inherit_mo_unit_cost" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.mo.unit.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="mo_unit_cost" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_tree_inherit_mo_unit_cost" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.mo.unit.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_qty']" position="after">
                <field name="mo_unit_cost" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
