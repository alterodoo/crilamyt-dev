<odoo>
    <data>
        <record id="view_sale_delivery_cancellation_log_tree" model="ir.ui.view">
            <field name="name">sale.delivery.cancellation.log.tree</field>
            <field name="model">sale.delivery.cancellation.log</field>
            <field name="arch" type="xml">
                <tree string="Historial de cancelaciones" create="false" delete="false">
                    <field name="create_date" string="Fecha"/>
                    <field name="order_id"/>
                    <field name="picking_id"/>
                    <field name="product_id"/>
                    <field name="quantity" sum="Total cancelado"/>
                    <field name="reason"/>
                    <field name="note"/>
                    <field name="user_id"/>
                </tree>
            </field>
        </record>

        <record id="view_sale_delivery_cancellation_log_form" model="ir.ui.view">
            <field name="name">sale.delivery.cancellation.log.form</field>
            <field name="model">sale.delivery.cancellation.log</field>
            <field name="arch" type="xml">
                <form string="Cancelacion de despacho" create="false" delete="false" edit="false">
                    <sheet>
                        <group>
                            <field name="create_date" string="Fecha"/>
                            <field name="user_id"/>
                            <field name="order_id"/>
                            <field name="picking_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="reason"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
