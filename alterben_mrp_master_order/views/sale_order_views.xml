<odoo>
    <record id="view_order_form_ab_forecast_hover_id" model="ir.ui.view">
        <field name="name">sale.order.form.ab.forecast.hover.id</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="x_bucket_token" invisible="1"/>
                <field name="route_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="before">
                <field name="x_bucket_option_id" string="Bodega"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="after">
                <field name="ab_cancelled_delivery_qty" string="Cant. cancelada" optional="show" readonly="1"/>
                <field name="ab_net_delivery_qty" string="Cant. neta" optional="show" readonly="1"/>
                <field name="ab_qty_to_deliver_net" string="Pendiente neta" optional="show" readonly="1"/>
                <button name="action_view_delivery_cancellations"
                        type="object"
                        icon="fa-history"
                        title="Ver historial de cancelaciones"
                        class="btn-link"
                        invisible="ab_cancelled_delivery_qty &lt;= 0"/>
                <button name="action_open_ab_forecast_detail"
                        type="object"
                        icon="fa-search-plus"
                        title="Ver detalle de disponibilidad"
                        class="btn-link ab-forecast-detail-btn"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="x_bucket_token" invisible="1"/>
                <field name="route_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="before">
                <field name="x_bucket_option_id" string="Bodega"/>
            </xpath>
        </field>
    </record>
</odoo>
