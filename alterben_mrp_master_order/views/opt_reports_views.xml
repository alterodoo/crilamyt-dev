                <field name="size_category" optional="hide"/>
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="uom_id"/>
                <field name="stock_qty" sum="Total"/>
                <button name="action_open_stock_detail" type="object" icon="fa-info-circle" title="Ver detalle de existencias" class="btn-link"/>
                <field name="sales_qty" sum="Total"/>
                <button name="action_open_sales_detail" type="object" icon="fa-info-circle" title="Ver detalle de ventas" class="btn-link"/>
                <field name="priority_sales_qty" sum="Total"/>
                <field name="in_process_qty" sum="Total"/>
                <button name="action_open_in_process_detail" type="object" icon="fa-info-circle" title="Ver detalle de en proceso" class="btn-link"/>
                <field name="shortfall_qty" sum="Total"/>
