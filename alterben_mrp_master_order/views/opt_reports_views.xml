    <record id="view_report_raw_material_consumption_line_search" model="ir.ui.view">
      <field name="name">mrp.report.raw.material.consumption.line.search</field>
      <field name="model">mrp.report.raw_material_consumption.line</field>
      <field name="arch" type="xml">
        <search string="Buscar consumos de materia prima">
          <field name="mo_name"/>
          <field name="pedido_original"/>
          <field name="origin_ref"/>
          <field name="source_location_name"/>
          <field name="finished_product_id"/>
          <field name="finished_categ_id"/>
          <field name="raw_product_id"/>
          <field name="raw_categ_id"/>
          <field name="qty_scrap"/>
          <group expand="0" string="Agrupar por">
            <filter string="MO" name="group_mo" context="{'group_by': 'production_id'}"/>
            <filter string="Pedido original" name="group_pedido_original" context="{'group_by': 'pedido_original'}"/>
            <filter string="Origen" name="group_origin" context="{'group_by': 'origin_ref'}"/>
            <filter string="Categoría final" name="group_finished_category" context="{'group_by': 'finished_categ_id'}"/>
            <filter string="Categoría MP" name="group_raw_category" context="{'group_by': 'raw_categ_id'}"/>
            <filter string="Materia prima" name="group_raw_product" context="{'group_by': 'raw_product_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="action_report_raw_material_consumption" model="ir.actions.act_window">
      <field name="name">Consumos de Materia prima</field>
      <field name="res_model">mrp.report.raw_material_consumption</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_report_raw_material_consumption_form"/>
      <field name="target">current</field>
    </record>

    <!-- Ventas sin stock -->
    <record id="view_report_sales_no_stock_form" model="ir.ui.view">
      <field name="name">mrp.report.sales.no.stock.form</field>
      <field name="model">mrp.report.sales_no_stock</field>
