          <field name="cost_s1_total" string="S1 $Total" column_invisible="not context.get('show_valued')"/>
          <field name="qty_s2" sum="Total"/>
          <button name="action_open_s2_detail" type="object" icon="fa-info-circle" string="" help="Ver detalle de S2"/>
          <field name="cost_unit" string="S2 $Unit" column_invisible="not context.get('show_valued')"/>
          <field name="cost_s2_total" string="S2 $Total" column_invisible="not context.get('show_valued')"/>
          <field name="qty_s3" sum="Total"/>
          <button name="action_open_s3_detail" type="object" icon="fa-info-circle" string="" help="Ver detalle de S3"/>
          <field name="cost_unit" string="S3 $Unit" column_invisible="not context.get('show_valued')"/>
          <field name="cost_s3_total" string="S3 $Total" column_invisible="not context.get('show_valued')"/>
          <field name="qty_pt" sum="Total"/>
          <button name="action_open_pt_detail" type="object" icon="fa-info-circle" string="" help="Ver detalle de PT"/>
          <field name="cost_unit" string="PT $Unit" column_invisible="not context.get('show_valued')"/>
          <field name="cost_pt_total" string="PT $Total" column_invisible="not context.get('show_valued')"/>
          <field name="qty_total" sum="Total"/>
          <button name="action_open_in_process_detail" type="object" icon="fa-info-circle" string="" help="Ver detalle de en proceso"/>
          <field name="cost_total" string="Total $" column_invisible="not context.get('show_valued')"/>
        </tree>
      </field>
    </record>

    <record id="view_report_in_process_line_search" model="ir.ui.view">
      <field name="name">mrp.report.in.process.line.search</field>
      <field name="model">mrp.report.in_process.line</field>
      <field name="arch" type="xml">
        <search string="Buscar lineas">
          <field name="product_id"/>
          <field name="product_code"/>
          <field name="product_name"/>
        </search>
      </field>
    </record>

    <record id="action_report_in_process" model="ir.actions.act_window">
      <field name="name">Productos en proceso</field>
      <field name="res_model">mrp.report.in_process</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_report_in_process_form"/>
      <field name="target">current</field>
    </record>

    <!-- Materias primas -->
    <record id="view_report_raw_materials_form" model="ir.ui.view">
      <field name="name">mrp.report.raw.materials.form</field>
      <field name="model">mrp.report.raw_materials</field>
      <field name="arch" type="xml">
          <form string="Reporte de materia prima">
          <header>
            <button name="action_generate" type="object" string="Generar reporte" class="btn-primary"/>
            <button name="action_open_lines" type="object" string="Ver lista" class="btn-secondary"/>
            <button name="action_print" type="object" string="Imprimir" class="btn-secondary"/>
            <button name="action_open_consumption_report" type="object" string="Consumos MP" class="btn-secondary"/>
          </header>
          <sheet>
            <div class="o_row">
              <div class="o_col-6">
                <group>
                  <group>
                    <field name="report_date"/>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="categ_ids" widget="many2many_tags"/>
                    <field name="size_filter" invisible="1"/>
                    <field name="turns_small" invisible="1"/>
                    <field name="hours_per_turn_small" invisible="1"/>
                  </group>
                  <group>
                    <field name="turns_large" invisible="1"/>
                    <field name="hours_per_turn_large" invisible="1"/>
                  </group>
                </group>
              </div>
            </div>
            <field name="line_ids">
              <tree editable="bottom" create="false" decoration-danger="is_extra" limit="80">
                <field name="is_extra" invisible="1"/>
                <field name="is_extra" string="No considerado" optional="hide"/>
                <field name="row_number" string="#" readonly="1" width="40"/>
                <field name="size_category" optional="hide"/>
                  <field name="product_id" optional="hide"/>
                  <field name="categ_id" optional="hide"/>
                  <field name="product_code"/>
                  <field name="product_name"/>
                  <field name="uom_id"/>
                  <field name="min_qty" sum="Total"/>
                  <field name="max_qty" sum="Total"/>
                   <field name="required_qty" sum="Total"/>
                   <button name="action_open_required_detail" type="object" icon="fa-info-circle" title="Ver detalle de requerido" class="btn-link"/>
                   <field name="stock_mp_qty" sum="Total"/>
                   <field name="plr_mp_display" string="PL/R MP"/>
                   <field name="stock_pre_qty" sum="Total"/>
                   <field name="plr_pre_display" string="PL/R Preproduccion"/>
                   <field name="in_process_qty" sum="Total"/>
                   <button name="action_open_raw_in_process_detail" type="object" icon="fa-info-circle" title="Ver detalle de en proceso" class="btn-link"/>
              </tree>
            </field>
          </sheet>
        </form>
      </field>
    </record>

      <record id="view_report_raw_materials_line_tree" model="ir.ui.view">
        <field name="name">mrp.report.raw.materials.line.tree</field>
        <field name="model">mrp.report.raw_materials.line</field>
        <field name="arch" type="xml">
          <tree editable="bottom" decoration-danger="is_extra" limit="80">
            <field name="is_extra" invisible="1"/>
            <field name="is_extra" string="No considerado" optional="hide"/>
            <field name="row_number" string="#" readonly="1" width="40"/>
            <field name="size_category" optional="hide"/>
            <field name="product_id" optional="hide"/>
            <field name="categ_id" optional="hide"/>
            <field name="product_code"/>
            <field name="product_name"/>
            <field name="uom_id"/>
            <field name="min_qty" sum="Total"/>
            <field name="max_qty" sum="Total"/>
            <field name="required_qty" sum="Total"/>
            <button name="action_open_required_detail" type="object" icon="fa-info-circle" title="Ver detalle de requerido" class="btn-link"/>
            <field name="stock_mp_qty" sum="Total"/>
            <field name="plr_mp_display" string="PL/R MP"/>
            <field name="stock_pre_qty" sum="Total"/>
            <field name="plr_pre_display" string="PL/R Preproduccion"/>
            <field name="in_process_qty" sum="Total"/>
            <button name="action_open_raw_in_process_detail" type="object" icon="fa-info-circle" title="Ver detalle de en proceso" class="btn-link"/>
        </tree>
      </field>
    </record>

    <record id="view_report_raw_materials_line_search" model="ir.ui.view">
      <field name="name">mrp.report.raw.materials.line.search</field>
      <field name="model">mrp.report.raw_materials.line</field>
      <field name="arch" type="xml">
        <search string="Buscar materias primas">
          <field name="product_id"/>
          <field name="categ_id"/>
          <field name="product_code"/>
          <field name="product_name"/>
          <filter string="No considerados" name="filter_is_extra" domain="[('is_extra', '=', True)]"/>
          <group expand="0" string="Agrupar por">
            <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
            <filter string="Categoria" name="group_category" context="{'group_by': 'categ_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="action_report_raw_materials" model="ir.actions.act_window">
      <field name="name">Reporte de materia prima</field>
      <field name="res_model">mrp.report.raw_materials</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_report_raw_materials_form"/>
      <field name="target">current</field>
    </record>

    <!-- Consumos de materia prima -->
    <record id="view_report_raw_material_consumption_form" model="ir.ui.view">
      <field name="name">mrp.report.raw.material.consumption.form</field>
      <field name="model">mrp.report.raw_material_consumption</field>
      <field name="arch" type="xml">
        <form string="Consumos de Materia prima">
          <header>
            <button name="action_generate" type="object" string="Generar reporte" class="btn-primary"/>
            <button name="action_open_lines" type="object" string="Ver lista" class="btn-secondary"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="raw_product_ids" widget="many2many_tags"/>
              </group>
              <group>
                <field name="raw_categ_ids" widget="many2many_tags"/>
                <field name="finished_categ_ids" widget="many2many_tags"/>
              </group>
            </group>
            <field name="line_ids">
              <tree editable="bottom" create="false" limit="80">
                <field name="row_number" string="#" readonly="1" width="40"/>
                <field name="date_done"/>
                <field name="mo_name"/>
                <field name="pedido_original"/>
                <field name="origin_ref"/>
                <field name="source_location_name"/>
                <field name="finished_categ_id" optional="hide"/>
                <field name="finished_product_code"/>
                <field name="finished_product_name"/>
                <field name="raw_categ_id" optional="show"/>
                <field name="raw_product_code"/>
                <field name="raw_product_name"/>
                <field name="uom_id"/>
                <field name="qty_consumed" sum="Total"/>
                <field name="qty_scrap" sum="Total"/>
                <field name="qty_total" sum="Total"/>
              </tree>
            </field>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_report_raw_material_consumption_line_tree" model="ir.ui.view">
      <field name="name">mrp.report.raw.material.consumption.line.tree</field>
      <field name="model">mrp.report.raw_material_consumption.line</field>
