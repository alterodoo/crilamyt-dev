<odoo>
    <data>
        <record id="view_stock_move_cancel_delivery_wizard_form" model="ir.ui.view">
            <field name="name">stock.move.cancel.delivery.wizard.form</field>
            <field name="model">stock.move.cancel.delivery.wizard</field>
            <field name="arch" type="xml">
                <form string="Cancelar despacho">
                    <sheet>
                        <group>
                            <field name="move_id" invisible="1"/>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                            <field name="product_id"/>
                            <field name="max_qty"/>
                            <field name="quantity"/>
                            <field name="reason"/>
                            <field name="note" placeholder="Detalle adicional de la cancelacion"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
